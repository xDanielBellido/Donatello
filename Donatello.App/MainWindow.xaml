<Window x:Class="Donatello.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Donatello.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Donatello viewport" Foreground="White" Margin="12,0" VerticalAlignment="Center" />

        <Border Grid.Row="1" Margin="12" BorderBrush="#555555" BorderThickness="1">
            <local:ViewportHost x:Name="Viewport" />
        </Border>
    </Grid>
</Window>
