<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

	<Target Name="CopyNativeLibrary" AfterTargets="Build">
		<Copy SourceFiles="$(MSBuildProjectDirectory)\..\x64\$(Configuration)\Donatello.Native.dll" DestinationFolder="$(TargetDir)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\..\x64\$(Configuration)\Donatello.Native.pdb" DestinationFolder="$(TargetDir)" Condition="'$(Configuration)' == 'Debug'" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\..\Donatello.Native\Triangle.hlsl" DestinationFolder="$(TargetDir)" />
	</Target>
	
</Project>
